{
  "name": "@knokh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/server.js",
    "test": "node --import tsx --test src/*.test.ts",
    "db:migrate": "node --import tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:commerce": "drizzle-kit migrate",
    "admin:grant": "node --import tsx src/bootstrap-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "better-auth": "^1.3.0",
    "cors": "^2.8.5",
    "drizzle-orm": "1.0.0-rc.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "1.2.22",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "22.10.2",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "1.0.0-rc.5",
    "embedded-postgres": "^18.6.0-beta.19",
    "mysql2": "^3.24.6",
    "prisma": "6.19.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
