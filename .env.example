# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Set these in the Convex deployment environment (not in VITE_ client variables).
# Create/verify a sender domain in Resend before configuring RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Deployment environment names only. Set secret values through the provider dashboard.
# Public storefront origin used for redirects by Convex Auth.
SITE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
KNOKH_PAYMENT_MODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
KNOKH_RAZORPAY_REFUNDS_ENABLED=
KNOKH_CASHFREE_SANDBOX_ENABLED=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=
KNOKH_DELIVERY_PLAN=
