# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Set these in the Convex deployment environment (not in VITE_ client variables).
# Create/verify a sender domain in Resend before configuring RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
