# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Set these in the Convex deployment environment (not in VITE_ client variables).
# Create/verify a sender domain in Resend before configuring RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public Pages build switch. Enable only after successful OAuth tests.
VITE_GOOGLE_SIGN_IN=false

# Convex deployment configuration. Set these in Convex, not the Pages build.
SITE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
KNOKH_GUEST_CHECKOUT_SECRET=
KNOKH_DELIVERY_CONFIG=
KNOKH_PAYMENT_MODE=
KNOKH_SANDBOX_SITE_ORIGIN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
